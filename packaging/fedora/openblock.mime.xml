<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared MIME-info for OpenBlock world archives. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openblock-world">
    <comment>OpenBlock world archive</comment>
    <comment xml:lang="de">OpenBlock-Weltarchiv</comment>
    <magic priority="60">
      <match type="string" value="OBWORLD" offset="0"/>
    </magic>
    <glob pattern="*.obworld"/>
  </mime-type>
</mime-info>
