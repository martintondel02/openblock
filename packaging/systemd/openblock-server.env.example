# Optional environment for openblock-server.service.
#
# Install as /etc/openblock/server.env (root:root 0644 is fine; the file holds
# no secrets in the interim build) or copy the values into a systemd drop-in:
#   sudo install -Dm644 packaging/systemd/openblock-server.env.example \
#       /etc/openblock/server.env
#   sudo systemctl restart openblock-server
#
# Only variables the server actually reads are listed here.

# Log level: trace, debug, info, warn, error or off (default: info).
# The server logs one line per event to stdout/stderr, which systemd forwards
# to the journal. It does not write its own log files in this build.
OPENBLOCK_LOG=info

# The packaged unit passes --data-dir /var/lib/openblock explicitly, so this
# variable is ignored under systemd. It is useful when running the binary by
# hand or from a different supervisor.
# OPENBLOCK_DATA_DIR=/var/lib/openblock

# Standard Rust panic backtrace switch. Enable temporarily when collecting a
# support report; leave it off in normal operation.
# RUST_BACKTRACE=1

# Do not put server.toml contents here: this build reads configuration only
# from --config/server.toml. There are no secrets or tokens to configure.
